# Copy to .env (gitignored) and fill locally. Names only in git — never values.

# LLM judge used by scripts/rubric_label.py. Any OpenAI-compatible
# /chat/completions endpoint works; the base URL is what selects the provider.
ITAIS_JUDGE_BASE=
ITAIS_JUDGE_MODEL=
ITAIS_JUDGE_API_KEY=

# LLM gateway used by scripts/label_laguna.py for the optional LLM lane.
COMMAND_CODE_BASE_URL=
COMMAND_CODE_MODEL=
COMMAND_CODE_API_KEY=

# Provider keys the generation scripts pick up if present.
TOKENROUTER_API_KEY=
OPENROUTER_API_KEY=

# Optional: raises HF rate limits when the trainer pulls the v2 corpus, and
# enables the checkpoint backup push in scripts/fine_tune_lfm.py.
HF_TOKEN=
